# Copy to %APPDATA%\reisulkuttab\.env (or beside config.py when running from source).
REISULKUTTAB_TRANSCRIBE_PROVIDER=local
REISULKUTTAB_CLEANUP_PROVIDER=agy
REISULKUTTAB_MEETING_PROVIDER=agy

# Hosted transcription. Select openai, groq, or openrouter before these are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: an OpenAI-compatible local proxy such as CLIProxyAPI.
# OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# OPENAI_API_KEY=your-proxy-token

